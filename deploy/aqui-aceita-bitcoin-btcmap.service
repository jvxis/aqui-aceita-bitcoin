# Cópia diária dos lugares do BTC Map no Brasil (btcmap_sync.py), para as páginas /onde-aceita. Instalar
# junto com o .timer:
#   cp deploy/aqui-aceita-bitcoin-btcmap.* /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now aqui-aceita-bitcoin-btcmap.timer
# O banco fica em btcmap.db na pasta do site (BTCMAP_DB_PATH muda), separado do database.db dos cadastros.
[Unit]
Description=Aceita Bitcoin? - copia diaria dos lugares do BTC Map no Brasil
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=webuser
Group=webuser
WorkingDirectory=/home/webuser/aqui-aceita-bitcoin
EnvironmentFile=-/etc/aqui-aceita-bitcoin.env
ExecStart=/home/webuser/aqui-aceita-bitcoin/venv/bin/python btcmap_sync.py run
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
